    <string name="lab_rotacion_titulo">Laboratorio de rotación</string>
    <string name="lab_rotacion_instruccion">Gira el teléfono lentamente sobre la mesa o con ambas manos, sin soltarlo.</string>
    <string name="lab_rotacion_exp_giro">Experimento: gira aproximadamente 90 grados</string>

    <!-- Pantalla 5: Laboratorio de sonido -->
    <string name="lab_sonido_titulo">Laboratorio de sonido</string>
    <string name="lab_sonido_permiso_explicacion">Para escuchar el sonido del ambiente necesitamos usar el micrófono. No grabamos ni guardamos audio: solo lo analizamos en el momento y lo olvidamos.</string>
    <string name="lab_sonido_permiso_boton">Permitir micrófono</string>
    <string name="lab_sonido_permiso_denegado">Sin el micrófono no podemos medir el sonido. Puedes intentarlo de nuevo cuando quieras.</string>
    <string name="lab_sonido_exp_aplauso">Experimento: un aplauso suave, a distancia prudente</string>
    <string name="lab_sonido_exp_hablar">Experimento: habla con voz normal</string>
    <string name="lab_sonido_exp_sostenido">Experimento: sonido sostenido (un \"aaaah\")</string>
    <string name="lab_sonido_exp_comparar_intensidad">Experimento: compara un sonido suave y uno fuerte</string>
    <string name="lab_sonido_exp_comparar_tono">Experimento: compara un sonido grave y uno agudo</string>

